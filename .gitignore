# Claude sessions
.claude/session-*
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/state/
.claude/worktrees/
.claude/logs/
*.txt
# ...but never swallow a dependency manifest. A bare `*.txt` rule
# hid two stale spec-kit requirements files from every dependency
# audit until one was found by hand. Ignoring build noise must not
# mean ignoring what the project installs.
!**/requirements*.txt

# Transient PR-review findings cache (not source)
.review/

# Python
**/*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.lock

# Virtual environments
.venv/
.*-venv/
.*-env/
venv/
ENV/
.uv-cache/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
.tools/
.uv-tools/

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json

# Linting
.ruff_cache/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Node.js (local dev tools only)
node_modules/
package.json
package-lock.json

# Build artifacts
*.log

# Plugin binaries (built from source, not committed)
plugins/*/bin/skrills
plugins/*/bin/.skrills-version

# Generated reports and scans
debt_scan_results.json
.demo-palaces/
reports/skill-graph.json
reviews/

# local docs
docs/plans/
docs/backlog/
docs/archive/
docs/marketing/
# Research syntheses and brainstorm design drafts are background,
# never the record. Fold the load-bearing evidence into the rule, ADR,
# or skill module that relies on it; a tracked doc must never cite a
# path under either directory. A draft that ships leaves its decision
# in an ADR and its contract in a test, so nothing here is load-bearing
# once the work lands.
docs/research/
docs/superpowers/
docs/implementation-plan.md
docs/project-brief.md
docs/specification.md
**/*/docs/plans/

# Attune ephemeral state
.attune/

# Git worktrees
.worktrees/

# Attune calibration data
.attune/

# Runtime state for egregore (manifest, clawhub progress) and
# superpowers (brainstorm session artifacts). Peers of .attune/.
.egregore/
.superpowers/

# Intake queue for memory palace artifacts
plugins/memory-palace/data/intake_queue.jsonl
plugins/memory-palace/data/state/
plugins/memory-palace/data/sessions/
plugins/memory-palace/data/telemetry/
plugins/memory-palace/.demo-palaces/
plugins/memory-palace/reports/

# Wiki-backed knowledge corpus (local clone, not committed to main repo)
plugins/memory-palace/data/wiki/

# Auto-captured research staging (local evaluation before promotion to wiki)
plugins/memory-palace/data/staging/webfetch-*.md
plugins/memory-palace/data/staging/websearch-*.md
plugins/memory-palace/data/staging/archive/

# Keyword index derived from those local captures. Rebuild it with
# plugins/memory-palace/scripts/build_indexes.py; committing it would
# track 9MB of entries pointing at files no other checkout has.
plugins/memory-palace/data/indexes/keyword-index.yaml
**/*.claude/session-state.md
clawhub/

# Tome research session state (the report in docs/research/ is also local;
# the deliverable is whatever tracked doc the findings get folded into)
.tome/

# imbue scope-ramp token (a per-session demonstration marker, not source)
.imbue/

# conserve unbloat scan log (transient artifact, not source)
.unbloat-log

# transient code-refinement synthesis artifacts (local eval, not source)
docs/refinement/

# superpowers brainstorm/design/plan scratch output. The shipped skill,
# rule, and tests are the record; rejected alternatives and deferred
# scope get folded into docs/adr/ (see ADR-0019) before the spec is dropped.
docs/superpowers/

# ephemeral dogfooding/review reports; fold durable lessons into docs/, not source
reports/

# knowledge-intake audit log; regenerated locally, mapping lives in palace frontmatter
docs/curation-log.md

# memory-palace graph DB; written by the test suite into an otherwise
# untracked runtime directory, regenerated on demand
plugins/memory-palace/data/palaces/*.db
