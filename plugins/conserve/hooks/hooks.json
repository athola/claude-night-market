{
  "hooks": {
    "Setup": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/setup.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/permission_request.py",
            "timeout": 2
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash|Skill|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/context_warning.py",
            "timeout": 1
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "_comment": "Monitor tool output bloat for verbose tools",
        "matcher": "Bash|Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/tool_output_summarizer.py",
            "timeout": 1
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "_comment": "Preserve critical context before compression",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/pre_compact_preserve.py",
            "timeout": 2
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/permission_denied_logger.py",
            "timeout": 2
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "_comment": "Order 1: Initialize conservation metrics and context tracking on session start/resume",
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh",
            "timeout": 2
          }
        ]
      }
    ],
    "Notification": [
      {
        "_comment": "Record background-agent notifications. Completion already reaches the model; this catches the agent that is blocked waiting for input, which is otherwise invisible.",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/background_agent_notice.py",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
